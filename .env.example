# Watch all groups if both lists are empty.
GROUP_IDS=
GROUP_NAMES=

# Backward-compatible aliases:
# GROUP_ID=
# GROUP_NAME=
INCLUDE_SELF=1

# Groq is the default summarizer if this key is present.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Tuning
SUMMARY_INTERVAL_SECONDS=300
SUMMARY_MIN_MESSAGES=5
DASHBOARD_ENABLED=1
DASHBOARD_PORT=3000
DASHBOARD_HOST=0.0.0.0

# Optional persistence overrides
DATA_DIR=/app/data
AUTH_DIR=/app/data/auth
SUMMARY_DIR=/app/data/summaries
LOG_FILE=/app/data/conversas.jsonl
SUMMARY_FILE=/app/data/conhecimento.md
